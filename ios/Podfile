# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

target 'scan bazar' do
  # Specific Firebase pods that require modular headers
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Set deployment targets and active arch, and clear any EXCLUDED_ARCHS from Pod targets
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        config.build_settings["ONLY_ACTIVE_ARCH"] = "YES"
        config.build_settings.delete('EXCLUDED_ARCHS')
        config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
      end
    end

    # Clear EXCLUDED_ARCHS from Pods project configuration
    installer.pods_project.build_configurations.each do |config|
      config.build_settings.delete('EXCLUDED_ARCHS')
      config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
    end

    # Clear EXCLUDED_ARCHS from main project targets to restore native simulator listing
    require 'xcodeproj'
    project_path = File.join(__dir__, 'ScanBazar.xcodeproj')
    project = Xcodeproj::Project.open(project_path)
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings.delete('EXCLUDED_ARCHS')
        config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
      end

      # Add a build phase to restore/patch MLKit binaries dynamically during build
      if target.name == 'scan bazar'
        phase_name = 'Restore or Patch MLKit Binaries'
        phase = target.shell_script_build_phases.find { |p| p.name == phase_name }
        unless phase
          phase = target.new_shell_script_build_phase(phase_name)
        end
        phase.shell_script = <<~SCRIPT
          # This script runs during the Xcode build phase.
          # It dynamically patches/restores MLKit frameworks based on whether we are building for Simulator or Device.

          exec > "${SRCROOT}/build_phase.log" 2>&1
          PODS_ROOT="${SRCROOT}/Pods"
          PATCH_SCRIPT="${SRCROOT}/patch_mlimage/patch_all_mlkit.py"

          echo "Running MLKit patch manager..."
          echo "Platform: $EFFECTIVE_PLATFORM_NAME"
          echo "SDK: $SDK_NAME"

          if [ "$EFFECTIVE_PLATFORM_NAME" = "-iphonesimulator" ]; then
            # Building for iOS Simulator: apply patch if not already applied
            if [ -f "$PATCH_SCRIPT" ]; then
              echo "Ensuring MLKit framework binaries are patched for Simulator..."
              python3 "$PATCH_SCRIPT" "$PODS_ROOT"
            else
              echo "Error: patch_all_mlkit.py not found at $PATCH_SCRIPT"
            fi
          else
            # Building for iOS Device: restore original unpatched binaries from backups
            echo "Restoring original MLKit framework binaries from backup for Device build..."
            find "$PODS_ROOT" -name "*.bak" | while read -r bak_path; do
              binary_path="${bak_path%.bak}"
              if [ -f "$bak_path" ]; then
                echo "  Restoring $binary_path from backup"
                cp -f "$bak_path" "$binary_path"
              fi
            done
          fi
        SCRIPT

        # Move the build phase to run as the very first step (index 1, right after CP Check Pods Manifest)
        target.build_phases.delete(phase)
        target.build_phases.insert(1, phase)
      end
    end
    project.save

    # Clean up EXCLUDED_ARCHS from all generated xcconfig files
    Dir.glob("Pods/Target Support Files/**/*.xcconfig").each do |xcconfig_path|
      xcconfig = File.read(xcconfig_path)
      new_xcconfig = xcconfig.gsub(/^EXCLUDED_ARCHS.*$/, "")
      File.open(xcconfig_path, "w") { |file| file << new_xcconfig }
    end

    # -----------------------------------------------------------------------
    # Patch ALL MLKit/MLImage arm64 slices: change LC_BUILD_VERSION platform
    # from iOS (2) to iOS Simulator (7) so arm64 simulator builds link cleanly.
    # Handles both ar archives and raw Mach-O object framework binaries.
    # Script is idempotent — safe to run on every `pod install`.
    # -----------------------------------------------------------------------
    patch_script_src = File.join(__dir__, 'patch_mlimage', 'patch_all_mlkit.py')
    if File.exist?(patch_script_src)
      pods_root = installer.sandbox.root.to_s
      system("python3 \"#{patch_script_src}\" \"#{pods_root}\"")
    end

    # Apply Xcode 26 workaround for fmt library if it exists
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      unless content.include?('Xcode 26 workaround')
        patched = content.gsub(
          /^(#elif defined\(__cpp_consteval\)\n#  define FMT_USE_CONSTEVAL) 1/,
          "// Xcode 26 workaround: disable consteval\n\\1 0"
        )
        if patched != content
          File.chmod(0644, fmt_base)
          File.write(fmt_base, patched)
        end
      end
    end
  end
end

